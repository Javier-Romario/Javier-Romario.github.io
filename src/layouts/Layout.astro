---
import { ClientRouter } from 'astro:transitions';
import '@javierromario/neondeck/global-fonts.css';
import '@javierromario/neondeck/global.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/site.css';
import '../styles/blog.css';
import HexBackground from '../components/HexBackground';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Portfolio of Javier Harford, software engineer.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      // Native document.startViewTransition() is broken across several
      // browsers (Safari, WebKit forks, and Firefox forks like Zen) — it
      // throws "Security Error: Content at ... may not load or link to
      // file:///" on http(s) pages. Disable it everywhere and let
      // ClientRouter's fallback="animate" CSS path (the
      // data-astro-transition-fallback attribute) drive the glitch instead.
      // One code path, no UA sniffing, no per-browser bugs.
      (function () {
        try { delete Document.prototype.startViewTransition; } catch (e) {}
        try { document.startViewTransition = undefined; } catch (e) {}
        try {
          Object.defineProperty(document, 'startViewTransition', {
            value: undefined,
            configurable: true,
            writable: true,
          });
        } catch (e) {}
      })();
    </script>
    <ClientRouter fallback="animate" />
    <script is:inline>
      // Apply saved theme before first paint. No attribute = follow system.
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.dataset.theme = t;
          }
        } catch (e) {}
        // Randomise the glitch page transition on each load.
        var s = document.documentElement.style;
        var n = function (min, max) { return (Math.random() * (max - min) + min).toFixed(1); };
        s.setProperty('--glitch-hue', Math.floor(Math.random() * 360) + 'deg');
        s.setProperty('--glitch-cut-a', n(6, 30) + '%');
        s.setProperty('--glitch-cut-b', n(8, 34) + '%');
        s.setProperty('--glitch-cut-c', n(4, 26) + '%');
        s.setProperty('--glitch-shift', n(6, 22) + 'px');
      })();
    </script>
  </head>
  <body>
    <HexBackground client:idle transition:persist />

    <header class="site-header">
      <a class="site-header__brand" href={base}>JAVIER<b>//</b>HARFORD</a>
      <div class="site-header__right">
        <nav class="site-header__links">
          <a href={`${base}#experience`} data-nav="experience">EXPERIENCE</a>
          <a href={`${base}#skills`} data-nav="skills">SKILLS</a>
          <a href={`${base}#contact`} data-nav="contact">CONTACT</a>
          <a href={`${base}blog/`} data-nav="blog">BLOG</a>
        </nav>
        <div class="theme-switch" role="group" aria-label="Colour theme">
          <button type="button" class="theme-switch__btn" data-theme="auto" title="Follow system">AUTO</button>
          <button type="button" class="theme-switch__btn" data-theme="light" title="Light">LIGHT</button>
          <button type="button" class="theme-switch__btn" data-theme="dark" title="Dark">DARK</button>
        </div>
      </div>
    </header>

    <div class="site-shell">
      <slot />
    </div>

    <footer class="site-footer site-shell">
      <p>
        Built with <a href="https://astro.build">Astro</a> +{' '}
        <a href="https://github.com/Javier-Romario/neondeck">NEONDECK</a>. © {new Date().getFullYear()}{' '}
        Javier Harford · <a href="mailto:javierharford@gmail.com">javierharford@gmail.com</a>
      </p>
    </footer>

    <script is:inline>
      // Theme switcher: auto (system) | light | dark. Event-delegated so it
      // works on any current/future button without per-button wiring.
      (function () {
        function current() {
          var t = document.documentElement.dataset.theme;
          return t === 'light' || t === 'dark' ? t : 'auto';
        }
        function paint() {
          var c = current();
          document.querySelectorAll('.theme-switch__btn').forEach(function (b) {
            b.classList.toggle('is-active', b.dataset.theme === c);
            b.setAttribute('aria-pressed', String(b.dataset.theme === c));
          });
        }
        if (!window.__ndThemeBound) {
          window.__ndThemeBound = true;
          document.addEventListener('click', function (e) {
            var btn = e.target && e.target.closest ? e.target.closest('.theme-switch__btn') : null;
            if (!btn) return;
            var t = btn.dataset.theme;
            try {
              if (t === 'auto') {
                delete document.documentElement.dataset.theme;
                localStorage.removeItem('theme');
              } else {
                document.documentElement.dataset.theme = t;
                localStorage.setItem('theme', t);
              }
            } catch (err) {}
            paint();
          });
          // SPA swap wipes <html> attributes (incl. data-theme), so re-apply
          // the saved preference after each client-side navigation.
          var reapply = function () {
            try {
              var t = localStorage.getItem('theme');
              if (t === 'light' || t === 'dark') {
                document.documentElement.dataset.theme = t;
              } else {
                delete document.documentElement.dataset.theme;
              }
            } catch (err) {}
            paint();
          };
          document.addEventListener('astro:after-swap', reapply);
          document.addEventListener('astro:page-load', reapply);
        }
        paint();
      })();
    </script>

    <script is:inline>
      // Subtle active-tab indication in the header (route + scrollspy).
      (function () {
        function setActive(id) {
          document.querySelectorAll('.site-header__links a[data-nav]').forEach(function (a) {
            a.classList.toggle('is-active', a.getAttribute('data-nav') === id);
          });
        }
        function isBlog() {
          return /^\/blog\/?/.test(location.pathname);
        }
        function detect() {
          if (isBlog()) {
            setActive('blog');
            return;
          }
          var ids = ['experience', 'skills', 'contact'];
          var sections = ids
            .map(function (id) { return document.getElementById(id); })
            .filter(Boolean);
          if (!sections.length) {
            setActive(null);
            return;
          }
          var marker = window.innerHeight * 0.3;
          var active = null;
          for (var i = 0; i < sections.length; i++) {
            var r = sections[i].getBoundingClientRect();
            if (r.top <= marker && r.bottom > marker) {
              active = sections[i].id;
              break;
            }
          }
          // at the bottom the last section can't reach the marker — force it
          var doc = document.documentElement;
          if (window.innerHeight + window.scrollY >= doc.scrollHeight - 4) {
            active = sections[sections.length - 1].id;
          }
          setActive(active);
        }
        if (!window.__ndNavBound) {
          window.__ndNavBound = true;
          var ticking = false;
          window.addEventListener(
            'scroll',
            function () {
              if (ticking) return;
              ticking = true;
              requestAnimationFrame(function () {
                ticking = false;
                if (!isBlog()) detect();
              });
            },
            { passive: true },
          );
          // Re-run on client-side navigation so the active tab follows the route.
          document.addEventListener('astro:page-load', detect);
        }
        detect();
      })();
    </script>
  </body>
</html>
