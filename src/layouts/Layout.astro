---
import '../neondeck/global-fonts.css';
import '../neondeck/global.css';
import '../styles/site.css';
import '../styles/blog.css';
import HexBackground from '../components/HexBackground';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Portfolio of Javier Harford, software engineer.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <HexBackground client:load />

    <header class="site-header">
      <a class="site-header__brand" href={base}>JAVIER<b>//</b>HARFORD</a>
      <nav class="site-header__links">
        <a href="#experience">EXPERIENCE</a>
        <a href="#skills">SKILLS</a>
        <a href={`${base}blog/`}>BLOG</a>
        <a href="#contact">CONTACT</a>
      </nav>
    </header>

    <div class="site-shell">
      <slot />
    </div>

    <footer class="site-footer site-shell">
      <p>
        Built with <a href="https://astro.build">Astro</a> +{' '}
        <a href="https://github.com/Javier-Romario/neondeck">NEONDECK</a>. © {new Date().getFullYear()}{' '}
        Javier Harford · <a href="mailto:javierharford@gmail.com">javierharford@gmail.com</a>
      </p>
    </footer>
  </body>
</html>
