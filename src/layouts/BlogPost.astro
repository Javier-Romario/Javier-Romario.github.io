---
import Layout from './Layout.astro';
import { Breadcrumbs, BrailleLoader } from '@neondeck';
import { postsInSeries, seriesById, neighbors } from '../data/blog';

interface Props {
  title: string;
  slug?: string;
  series?: string;
}

const { title, slug = '', series = '' } = Astro.props;
const s = await seriesById(series);
const list = await postsInSeries(series);
const { prev, next, index } = await neighbors(series, slug);
const posPct = index >= 0 && list.length ? Math.round(((index + 1) / list.length) * 100) : 0;
// Braille bar grows with progress (increase) and shrinks going back (decrease).
const brailleCells = Math.max(2, Math.round((posPct / 100) * 8));
const base = import.meta.env.BASE_URL;

const crumbs = [
  { name: 'BLOG', url: `${base}blog/` },
  ...(s ? [{ name: s.title }] : []),
];
---

<Layout title={`${title} — ${s?.title ?? 'Blog'}`} description={s?.blurb}>
  <article class="blog-post">
    <header class="blog-series">
      <Breadcrumbs items={crumbs} />
      {slug && index >= 0 && list.length > 0 && (
        <BrailleLoader
          variant="bar"
          tone="teal"
          cells={brailleCells}
          label={`${index + 1} / ${list.length}`}
          title={`${index + 1} of ${list.length} posts (${posPct}%)`}
        />
      )}
    </header>

    <div class="blog-body">
      <slot />
    </div>

    <nav class="blog-pager">
      {prev
        ? <a class="blog-pager__prev" href={`${base}blog/${series}/${prev.slug}/`}>← {prev.title}</a>
        : <span></span>}
      {next
        ? <a class="blog-pager__next" href={`${base}blog/${series}/${next.slug}/`}>{next.title} →</a>
        : <span></span>}
    </nav>
  </article>
</Layout>
