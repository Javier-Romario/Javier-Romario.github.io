---
import { Panel } from '@neondeck';

interface Props {
  title?: string;
  points: string[];
}
const { title = 'YOU BUILT', points } = Astro.props;
---

<Panel shape="wipeout" tone="green" className="recap">
  <div class="head">✓ {title}</div>
  <ul>
    {points.map((p) => <li>{p}</li>)}
  </ul>
</Panel>
