---
import { Panel } from '@neondeck';

interface Props {
  math: string;
  note?: string;
}
const { math, note } = Astro.props;
---

<Panel shape="terminal" tone="teal" className="formula-card">
  <div class="label">// the formula</div>
  <div class="math">{math}</div>
  {note && <div class="note">{note}</div>}
</Panel>
