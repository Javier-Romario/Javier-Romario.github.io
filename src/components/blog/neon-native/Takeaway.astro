---
import { Panel } from '@neondeck';

interface Props {
  math: string;
  note?: string;
  label?: string;
}
const { math, note, label = '// the takeaway' } = Astro.props;
---

<Panel shape="chamfer" tone="teal" className="takeaway">
  <div class="label">{label}</div>
  <div class="math">{math}</div>
  {note && <div class="note">{note}</div>}
</Panel>
