---
interface Props {
  glyph: string;
  label: string;
}

const { glyph, label } = Astro.props;
---

<svg class="series-cover" viewBox="0 0 320 180" role="img" aria-label={`${label} — ${glyph}`}>
  <polygon class="series-cover__hex" points="160,28 205,54 205,106 160,132 115,106 115,54" />
  <text class="series-cover__glyph" x="160" y="84" text-anchor="middle" dominant-baseline="central">
    {glyph}
  </text>
  <text class="series-cover__label" x="160" y="160" text-anchor="middle">{label}</text>
</svg>
