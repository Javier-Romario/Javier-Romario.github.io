---
import Layout from '../../layouts/Layout.astro';
import BlogGrid from '../../components/BlogGrid';
import { TickerBoard } from '@neondeck';
import { allSeries, postsInSeries } from '../../data/blog';

const base = import.meta.env.BASE_URL;

const GLYPHS: Record<string, { glyph: string; label: string }> = {
  'iso-tactics': { glyph: 'ISO', label: 'TACTICS' },
  'neon-native': { glyph: 'RN', label: 'EXPO' },
  'blender-masterclass': { glyph: '3D', label: 'FORGE' },
  'neon-canvas': { glyph: 'AI', label: 'GRAPH' },
};

const seriesList = await Promise.all(
  (await allSeries()).map(async (series) => {
    const posts = await postsInSeries(series.id);
    const latest = posts.reduce((m, p) => (p.updated > m ? p.updated : m), '');
    const art = GLYPHS[series.id] ?? { glyph: series.title.slice(0, 2), label: '' };
    return {
      id: series.id,
      title: series.title,
      blurb: series.blurb,
      tone: series.tone,
      tag: series.tag,
      glyph: art.glyph,
      label: art.label,
      updated: latest,
      parts: posts.length,
      href: posts.length === 1 ? `${base}blog/${series.id}/${posts[0].slug}/` : null,
      posts: posts.map((p) => ({
        slug: p.slug,
        title: p.title,
        tag: p.tag,
        updated: p.updated,
        href: `${base}blog/${series.id}/${p.slug}/`,
      })),
    };
  }),
);
---

<Layout
  title="Blog — Javier Harford"
  description="Write-ups: isometric tactics games, React Native + Expo, Blender, and an AI mindmapping canvas."
>
  <section class="blog-index">
    <header class="blog-hero">
      <TickerBoard
        message="BLOG"
        messageTone="teal"
        tickerItems={seriesList.map((s) => s.title)}
        tickerLabel="SERIES"
        tickerTone="teal"
        showTopTicker={true}
      >
        <div class="blog-hero__text">
          <span class="step__num">Writings</span>
          <h1 class="blog-hero__title">Blog</h1>
          <p class="blog-hero__lede">
            Multi-page guides and project write-ups — built with MDX, Astro, and live React demos.
          </p>
        </div>
      </TickerBoard>
    </header>

    <BlogGrid client:idle seriesList={seriesList} />
  </section>
</Layout>
