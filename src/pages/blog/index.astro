---
import Layout from '../../layouts/Layout.astro';
import Grid from '@components/Grid';
import SeriesCover from '../../components/SeriesCover.astro';
import { SERIES, postsInSeries } from '../../data/blog';

const base = import.meta.env.BASE_URL;

const GLYPHS: Record<string, { glyph: string; label: string }> = {
  'iso-tactics': { glyph: 'ISO', label: 'TACTICS' },
  'neon-native': { glyph: 'RN', label: 'EXPO' },
  'blender-masterclass': { glyph: '3D', label: 'FORGE' },
  'neon-canvas': { glyph: 'AI', label: 'GRAPH' },
};
---

<Layout
  title="Blog — Javier Harford"
  description="Write-ups: isometric tactics games, React Native + Expo, Blender, and an AI mindmapping canvas."
>
  <section class="blog-index">
    <header class="blog-hero">
      <svg class="blog-hero__img" viewBox="0 0 220 160" role="img" aria-label="Terminal prompt">
        <rect class="blog-hero__frame" x="10" y="10" width="200" height="140" rx="14" />
        <circle class="blog-hero__dot blog-hero__dot--a" cx="34" cy="30" r="5" />
        <circle class="blog-hero__dot blog-hero__dot--b" cx="50" cy="30" r="5" />
        <circle class="blog-hero__dot blog-hero__dot--c" cx="66" cy="30" r="5" />
        <text class="blog-hero__prompt" x="30" y="102">&gt;_</text>
        <rect class="blog-hero__cursor" x="96" y="78" width="16" height="28" rx="3" />
        <line class="blog-hero__scan" x1="0" y1="70" x2="220" y2="70" />
      </svg>
      <div class="blog-hero__text">
        <span class="step__num">Writings</span>
        <h1 class="blog-hero__title">Blog</h1>
        <p class="blog-hero__lede">
          Multi-page guides and project write-ups — built with MDX, Astro, and live React demos.
        </p>
      </div>
    </header>

    <Grid>
      {SERIES.map((series) => {
        const posts = postsInSeries(series.id);
        const latest = posts.reduce((m, p) => (p.updated > m ? p.updated : m), '');
        const parts = posts.length;
        const meta = `${series.tag} · ${parts} part${parts === 1 ? '' : 's'} · updated ${latest}`;
        const art = GLYPHS[series.id] ?? { glyph: series.title.slice(0, 2), label: '' };

        // Multi-page article → collapsible at the page level.
        if (parts > 1) {
          return (
            <details class="article-card" data-tone={series.tone}>
              <summary class="article-card__summary">
                <SeriesCover glyph={art.glyph} label={art.label} />
                <div class="article-card__text">
                  <h2 class="article-card__title">{series.title}</h2>
                  <p class="article-card__desc">{series.blurb}</p>
                  <div class="article-card__meta">
                    <span>{meta}</span>
                    <span class="article-card__chevron" aria-hidden="true">▸</span>
                  </div>
                </div>
              </summary>
              <div class="article-card__body">
                <ol class="article-pages">
                  {posts.map((post) => (
                    <li>
                      <a href={`${base}blog/${series.id}/${post.slug}/`}>
                        <span class="article-pages__tag">{post.tag}</span>
                        <span class="article-pages__title">{post.title}</span>
                        <time class="article-pages__date">{post.updated}</time>
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
            </details>
          );
        }

        // Single-page article → plain card.
        return (
          <article class="article-card" data-tone={series.tone}>
            <SeriesCover glyph={art.glyph} label={art.label} />
            <div class="article-card__text">
              <h2 class="article-card__title">{series.title}</h2>
              <p class="article-card__desc">{series.blurb}</p>
              <div class="article-card__meta">
                <span>{meta}</span>
              </div>
              <a class="article-card__link" href={`${base}blog/${series.id}/${posts[0].slug}/`}>
                Read →
              </a>
            </div>
          </article>
        );
      })}
    </Grid>
  </section>
</Layout>
