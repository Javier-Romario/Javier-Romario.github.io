---
import Layout from '../../layouts/Layout.astro';
import { SERIES, POSTS, postsInSeries } from '../../data/blog';

const base = import.meta.env.BASE_URL;
---

<Layout title="Blog — Javier Harford" description="Write-ups: isometric tactics games, React Native + Expo, and an AI mindmapping canvas.">
  <section class="blog-index">
    <header class="blog-index__head">
      <span class="step__num">Writings</span>
      <h1 class="blog-index__title">Blog</h1>
      <p class="blog-index__lede">
        Multi-page guides and project write-ups — built with MDX, Astro, and live React demos.
      </p>
    </header>

    {SERIES.map((series) => {
      const posts = postsInSeries(series.id);
      return (
        <section class={`blog-series-card blog-series-card--${series.tone}`}>
          <div class="blog-series-card__head">
            <div>
              <span class="blog-series-card__tag">{series.tag}</span>
              <h2 class="blog-series-card__title">{series.title}</h2>
            </div>
          </div>
          <p class="blog-series-card__blurb">{series.blurb}</p>
          <ol class="blog-post-list">
            {posts.map((post) => (
              <li>
                <a href={`${base}blog/${series.id}/${post.slug}/`}>
                  <span class="blog-post-list__tag">{post.tag}</span>
                  <span class="blog-post-list__title">{post.title}</span>
                  <span class="blog-post-list__blurb">{post.blurb}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      );
    })}
  </section>
</Layout>
