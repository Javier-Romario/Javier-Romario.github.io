---
import Layout from '../layouts/Layout.astro';
import me from '../assets/me.jpg';
import { NeoCard, NeoAccordion, Badge, Divider, RowSpaceBetween, Text } from '@javierromario/neondeck';

const skills = [
  'TypeScript',
  'JavaScript',
  'Vue',
  'Nuxt',
  'React',
  'Next.js',
  'Node.js',
  'Pinia',
  'Tailwind CSS',
  'HTML Canvas',
  'Web Workers',
  'Laravel',
  'DatoCMS',
  'Express',
  'GraphQL',
  'OpenAPI',
  'Sentry',
  'JWT',
  'Jest',
  'Cypress',
  'Docker',
  'Postgres',
  'PHP',
  'Git',
  'Testing',
  'NPM',
  'Astro',
];

const skillGroups = [
  {
    name: 'Frontend',
    tone: 'teal',
    items: ['TypeScript', 'JavaScript', 'Vue', 'Nuxt', 'React', 'Next.js', 'Pinia', 'Tailwind CSS', 'HTML Canvas', 'Web Workers'],
  },
  {
    name: 'Backend',
    tone: 'blue',
    items: ['Node.js', 'Express', 'Laravel', 'GraphQL', 'OpenAPI', 'JWT', 'Postgres', 'PHP', 'WordPress', 'DatoCMS'],
  },
  {
    name: 'Tooling',
    tone: 'violet',
    items: ['Jest', 'Cypress', 'Testing', 'Docker', 'Sentry', 'Git', 'NPM', 'Astro'],
  },
];

const experience = [
  {
    id: 'bright',
    company: 'Bright Software Group',
    url: 'https://brightsg.com/',
    location: 'Warwick, UK',
    role: 'Software Engineer',
    period: 'May 2024 — Present',
    tone: 'teal',
    summary:
      'Frontend Developer and sole frontend engineer on a cross-functional team building an AI-powered document processing application, taken from post-MVP through to general release.',
    bullets: [
      'Built a high-performance document previewer using HTML Canvas and Web Workers.',
      'Modernised a legacy interface in place — no full rewrite, zero downtime for users.',
      'Introduced testing practices across two products that previously had zero coverage.',
      'Owns technical decisions, PR reviews, and stakeholder communication.',
    ],
    stack: ['Vue', 'Nuxt', 'TypeScript', 'Pinia'],
  },
  {
    id: 'sifted',
    company: 'Sifted',
    url: 'https://sifted.eu',
    location: 'London, UK',
    role: 'Software Engineer',
    period: 'Aug 2019 — Aug 2023',
    tone: 'magenta',
    summary:
      "Part of a focused engineering team at Europe's leading media brand for the startup community, backed by the Financial Times.",
    bullets: [
      'Migrated a large editorial website from WordPress to Next.js with React — scaling from hundreds of monthly page views to over a million (a 100x increase).',
      'Ported the codebase from JavaScript to TypeScript and introduced Tailwind CSS.',
      'Built the homepage, interactive image galleries, editorial pages, and navigation components.',
      'Contributed Node.js backend work: automated OpenAPI documentation, Datadog and Sentry logging, JWT authentication.',
      'Integrated and migrated to new headless CMS platforms, building MVP solutions to compare competing products.',
      'Led DatoCMS plugins that saved the research team hundreds of data-entry hours.',
      'Extended and customised the WordPress backend during the transition.',
      'Built shared component libraries published as NPM packages.',
    ],
    stack: ['Next.js', 'React', 'TypeScript', 'Node.js', 'Express', 'Tailwind CSS', 'GraphQL', 'Jest', 'Cypress', 'Docker', 'Postgres', 'DatoCMS', 'WordPress'],
  },
  {
    id: 'mettrr',
    company: 'Mettrr',
    url: 'https://mettrr.com/',
    location: 'London, UK',
    role: 'Software Engineer — Front End Team',
    period: 'Aug 2017 — 2019',
    tone: 'violet',
    summary:
      'Early-career full-stack work across a live sales platform for international agents.',
    bullets: [
      'Led a live-updating, multi-role sales call calendar for international agents using Vue.js, fed by a Laravel backend.',
      'Extended the E2E-tested user dashboard using Node.js and Vue.js.',
      'Extended elements of the production CRM frontend.',
      'Maintained the customer-facing website.',
    ],
    stack: ['Vue', 'Laravel', 'Node.js', 'JavaScript', 'Webpack', 'Git'],
  },
];

const education = [
  {
    id: 'herts',
    school: 'University of Hertfordshire',
    period: '2011 — 2012',
    qualification: 'Foundation — Aerospace Engineering',
    modules: ['Mathematics', 'Mechanical Engineering', 'Electronic Engineering', 'Physics & Material Science'],
  },
  {
    id: 'bromley',
    school: 'Bromley College',
    period: '2009 — 2011',
    qualification: 'Electronic & Electrical Engineering',
    modules: ['Electronic circuit construction & testing', 'Operation & maintenance of electronic systems'],
  },
];
---

<Layout
  title="Javier Harford — Software Engineer"
  description="Portfolio of Javier Harford, a software engineer specialising in TypeScript, Vue, Nuxt, Next.js and Node.js."
>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <NeoCard title="SOFTWARE ENGINEER" tone="teal" ticker tickerLabel="STACK" tickerItems={skills} tickerSpeed={30}>
      <div class="hero__inner">
        <img
          class="hero__portrait"
          src={me.src}
          width={me.width}
          height={me.height}
          alt="Javier Harford"
        />
        <h1 class="hero__name">Javier Harford</h1>
        <p class="hero__eyebrow">Leicestershire, UK</p>
        <p class="hero__lede">
          Driven and ambitious engineer working across the modern JavaScript ecosystem — with
          particular depth in <strong>TypeScript</strong>, <strong>Vue</strong>, <strong>Nuxt</strong>,
          <strong>React</strong>, <strong>Next.js</strong> and <strong>Node.js</strong>. Passionate about crafting
          high-quality software and staying at the forefront of emerging technologies.
        </p>
        <div class="hero__actions">
          <a href="mailto:javierharford@gmail.com">Email me</a>
          <a href="https://github.com/Javier-Romario" target="_blank" rel="noopener">GitHub</a>
          <a href="https://www.linkedin.com/in/javier-romario-0a64727b" target="_blank" rel="noopener">LinkedIn</a>
        </div>
      </div>
    </NeoCard>
  </section>

  <!-- ============ EXPERIENCE ============ -->
  <section class="step" id="experience">
    <div class="step__head">
      <span class="step__num">Experience</span>
      <h2 class="step__title">Where I've built</h2>
    </div>

    <div class="stack">
      {experience.map((job) => (
        <NeoCard title={job.company} tone={job.tone}>
          <div class="job">
            <RowSpaceBetween style={{ flexWrap: 'wrap' }}>
              <Badge>ROLE</Badge>
              <Text>{job.role}</Text>
            </RowSpaceBetween>
            <Divider />
            <RowSpaceBetween style={{ flexWrap: 'wrap' }}>
              <Badge>PERIOD</Badge>
              <Text>{job.period}</Text>
            </RowSpaceBetween>
            <Divider />
            <RowSpaceBetween style={{ flexWrap: 'wrap' }}>
              <Badge>LOCATION</Badge>
              <Text>{job.location}</Text>
            </RowSpaceBetween>
            <Divider />

            <p class="job__summary">{job.summary}</p>

            <ul class="job__bullets">
              {job.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>

            <div class="job__stack">
              {job.stack.map((tech) => (
                <span class="pill">{tech}</span>
              ))}
            </div>
          </div>
        </NeoCard>
      ))}
    </div>
  </section>

  <!-- ============ SKILLS ============ -->
  <section class="step" id="skills">
    <div class="step__head">
      <span class="step__num">Capabilities</span>
      <h2 class="step__title">Skills &amp; technologies</h2>
    </div>

    <NeoCard title="TOOLKIT" tone="blue">
      <div class="stack" style="gap: 8px">
        {skillGroups.map((group) => (
          <NeoAccordion client:load title={group.name} tone={group.tone} defaultValue={group.name === 'Frontend'}>
            <div class="job__stack">
              {group.items.map((skill) => (
                <span class="pill">{skill}</span>
              ))}
            </div>
          </NeoAccordion>
        ))}
      </div>
    </NeoCard>
  </section>

  <!-- ============ EDUCATION ============ -->
  <section class="step" id="education">
    <div class="step__head">
      <span class="step__num">Education</span>
      <h2 class="step__title">Formal training</h2>
    </div>

    <div class="flow flow--2">
      {education.map((ed) => (
        <NeoCard title={ed.school} tone="teal">
          <div class="job">
            <RowSpaceBetween style={{ flexWrap: 'wrap' }}>
              <Badge>QUALIFICATION</Badge>
              <Text>{ed.qualification}</Text>
            </RowSpaceBetween>
            <Divider />
            <RowSpaceBetween style={{ flexWrap: 'wrap' }}>
              <Badge>PERIOD</Badge>
              <Text>{ed.period}</Text>
            </RowSpaceBetween>
            <Divider />

            <ul class="edu__modules">
              {ed.modules.map((m) => (
                <li>{m}</li>
              ))}
            </ul>
          </div>
        </NeoCard>
      ))}
    </div>
  </section>

  <!-- ============ ABOUT ============ -->
  <section class="step" id="about">
    <div class="step__head">
      <span class="step__num">About</span>
      <h2 class="step__title">Off the clock</h2>
    </div>

    <NeoCard title="HUMAN SIDE" tone="green">
      <p class="about-text">
        Developer based in Leicestershire. In my spare time I enjoy{' '}
        <strong>skateboarding</strong>, <strong>breakdancing</strong> and playing{' '}
        <strong>chess</strong>.
      </p>
    </NeoCard>
  </section>

  <!-- ============ CONTACT ============ -->
  <section class="step" id="contact">
    <div class="step__head">
      <span class="step__num">Contact</span>
      <h2 class="step__title">Get in touch</h2>
    </div>

    <NeoCard title="REACH ME" tone="magenta">
      <div class="job">
        <RowSpaceBetween style={{ flexWrap: 'wrap' }}>
          <Badge>EMAIL</Badge>
          <a class="contact-link" href="mailto:javierharford@gmail.com">javierharford@gmail.com</a>
        </RowSpaceBetween>
        <Divider />
        <RowSpaceBetween style={{ flexWrap: 'wrap' }}>
          <Badge>GITHUB</Badge>
          <a class="contact-link" href="https://github.com/Javier-Romario" target="_blank" rel="noopener">github.com/Javier-Romario</a>
        </RowSpaceBetween>
        <Divider />
        <RowSpaceBetween style={{ flexWrap: 'wrap' }}>
          <Badge>LINKEDIN</Badge>
          <a class="contact-link" href="https://www.linkedin.com/in/javier-romario-0a64727b" target="_blank" rel="noopener">linkedin.com/in/javier-romario-0a64727b</a>
        </RowSpaceBetween>
      </div>
    </NeoCard>
  </section>
</Layout>
