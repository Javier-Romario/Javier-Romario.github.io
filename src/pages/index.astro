---
import Layout from '../layouts/Layout.astro';
import MatrixRain from '@components/MatrixRain';
import TickerBoard from '@components/TickerBoard';
import Card from '@components/Card';
import Window from '@components/Window';
import Badge from '@components/Badge';
import Text from '@components/Text';
import Divider from '@components/Divider';
import Table from '@components/Table';
import TableRow from '@components/TableRow';
import TableColumn from '@components/TableColumn';
import GlitchText from '@components/GlitchText';

const skills = [
  'TypeScript',
  'JavaScript',
  'Vue',
  'Nuxt',
  'React',
  'Next.js',
  'Node.js',
  'Pinia',
  'Tailwind CSS',
  'HTML Canvas',
  'Web Workers',
  'Laravel',
  'DatoCMS',
  'Express',
  'GraphQL',
  'OpenAPI',
  'Sentry',
  'JWT',
  'Jest',
  'Cypress',
  'Docker',
  'Postgres',
  'PHP',
  'Git',
  'Testing',
  'NPM',
  'Astro',
];

const experience = [
  {
    id: 'bright',
    company: 'Bright Software Group',
    url: 'https://brightsg.com/',
    location: 'Warwick, UK',
    role: 'Software Engineer',
    period: 'May 2024 — Present',
    tone: 'teal',
    summary:
      'Frontend Developer and sole frontend engineer on a cross-functional team building an AI-powered document processing application, taken from post-MVP through to general release.',
    bullets: [
      'Built a high-performance document previewer using HTML Canvas and Web Workers.',
      'Modernised a legacy interface in place — no full rewrite, zero downtime for users.',
      'Introduced testing practices across two products that previously had zero coverage.',
      'Owns technical decisions, PR reviews, and stakeholder communication.',
    ],
    stack: ['Vue', 'Nuxt', 'TypeScript', 'Pinia'],
  },
  {
    id: 'sifted',
    company: 'Sifted',
    url: 'https://sifted.eu',
    location: 'London, UK',
    role: 'Software Engineer',
    period: 'Aug 2019 — Aug 2023',
    tone: 'magenta',
    summary:
      "Part of a focused engineering team at Europe's leading media brand for the startup community, backed by the Financial Times.",
    bullets: [
      'Migrated a large editorial website from WordPress to Next.js with React — scaling from hundreds of monthly page views to over a million (a 100x increase).',
      'Ported the codebase from JavaScript to TypeScript and introduced Tailwind CSS.',
      'Built the homepage, interactive image galleries, editorial pages, and navigation components.',
      'Contributed Node.js backend work: automated OpenAPI documentation, Datadog and Sentry logging, JWT authentication.',
      'Integrated and migrated to new headless CMS platforms, building MVP solutions to compare competing products.',
      'Led DatoCMS plugins that saved the research team hundreds of data-entry hours.',
      'Extended and customised the WordPress backend during the transition.',
      'Built shared component libraries published as NPM packages.',
    ],
    stack: ['Next.js', 'React', 'TypeScript', 'Node.js', 'Express', 'Tailwind CSS', 'GraphQL', 'Jest', 'Cypress', 'Docker', 'Postgres', 'DatoCMS', 'WordPress'],
  },
  {
    id: 'mettrr',
    company: 'Mettrr',
    url: 'https://mettrr.com/',
    location: 'London, UK',
    role: 'Software Engineer — Front End Team',
    period: 'Aug 2017 — 2019',
    tone: 'violet',
    summary:
      'Early-career full-stack work across a live sales platform for international agents.',
    bullets: [
      'Led a live-updating, multi-role sales call calendar for international agents using Vue.js, fed by a Laravel backend.',
      'Extended the E2E-tested user dashboard using Node.js and Vue.js.',
      'Extended elements of the production CRM frontend.',
      'Maintained the customer-facing website.',
    ],
    stack: ['Vue', 'Laravel', 'Node.js', 'JavaScript', 'Webpack', 'Git'],
  },
];

const education = [
  {
    id: 'herts',
    school: 'University of Hertfordshire',
    period: '2011 — 2012',
    qualification: 'Foundation — Aerospace Engineering',
    modules: ['Mathematics', 'Mechanical Engineering', 'Electronic Engineering', 'Physics & Material Science'],
  },
  {
    id: 'bromley',
    school: 'Bromley College',
    period: '2009 — 2011',
    qualification: 'Electronic & Electrical Engineering',
    modules: ['Electronic circuit construction & testing', 'Operation & maintenance of electronic systems'],
  },
];
---

<Layout
  title="Javier Harford — Software Engineer"
  description="Portfolio of Javier Harford, a software engineer specialising in TypeScript, Vue, Nuxt, Next.js and Node.js."
>
  <!-- ============ HERO ============ -->
  <section id="top" class="hero">
    <div class="hero__bg">
      <MatrixRain client:load height={440} color="#00ffd1" density={0.5} />
    </div>
    <div class="hero__inner">
      <GlitchText
        client:load
        text="JAVIER HARFORD"
        color="#00ffd1"
        accentA="#ff2d78"
        accentB="#2de2ff"
        fontSize={52}
        height={140}
      />
      <p class="hero__role">SOFTWARE ENGINEER</p>
      <p class="hero__location">LEICESTERSHIRE, UK</p>
      <p class="hero__lede">
        Driven and ambitious engineer working across the modern JavaScript ecosystem — with
        particular depth in <strong>TypeScript</strong>, <strong>Vue</strong>, <strong>Nuxt</strong>,
        <strong>Next.js</strong> and <strong>Node.js</strong>. Passionate about crafting
        high-quality software and staying at the forefront of emerging technologies.
      </p>
      <div class="hero__links">
        <a class="hero__cta" href="mailto:javierharford@gmail.com">EMAIL ME</a>
        <a class="hero__cta hero__cta--ghost" href="https://github.com/Javier-Romario" target="_blank" rel="noopener">GITHUB ↗</a>
        <a class="hero__cta hero__cta--ghost" href="https://www.linkedin.com/in/javier-romario-0a64727b" target="_blank" rel="noopener">LINKEDIN ↗</a>
      </div>
    </div>
  </section>

  <TickerBoard
    message="SYS.UPLINK // NODE 0x1F"
    messageTone="magenta"
    tickerLabel="STACK"
    tickerItems={skills}
    tickerSpeed={34}
    showTopTicker
    showBottomTicker
  >
    <div class="ticker-inner">
      <Text><strong>Primary stack</strong> — TypeScript · Vue · Nuxt · Next.js · React · Node.js</Text>
    </div>
  </TickerBoard>

  <!-- ============ EXPERIENCE ============ -->
  <section class="step" id="experience">
    <div class="step__head">
      <span class="step__num">EXPERIENCE</span>
      <h2 class="step__title">Where I've built</h2>
    </div>

    {experience.map((job) => (
      <Card title={job.company} mode="left" style={{ marginBottom: 20 }}>
        <Window>
          <div class="job">
            <div class="job__meta">
              <span class="job__role">{job.role}</span>
              <span class="job__period">{job.period}</span>
              <span class="job__location">{job.location}</span>
              <a class="job__url" href={job.url} target="_blank" rel="noopener">{job.url.replace(/^https?:\/\//, '')}</a>
            </div>

            <Text>{job.summary}</Text>

            <Divider />

            <ul class="job__bullets">
              {job.bullets.map((bullet) => (
                <li><span class="job__dot" data-tone={job.tone}>◈</span>{bullet}</li>
              ))}
            </ul>

            <Divider />

            <div class="job__stack">
              {job.stack.map((tech) => (
                <Badge>{tech}</Badge>
              ))}
            </div>
          </div>
        </Window>
      </Card>
    ))}
  </section>

  <!-- ============ SKILLS ============ -->
  <section class="step" id="skills">
    <div class="step__head">
      <span class="step__num">CAPABILITIES</span>
      <h2 class="step__title">Skills &amp; technologies</h2>
    </div>
    <Card title="TOOLKIT">
      <Window>
        <div class="skills">
          {skills.map((skill) => (
            <Badge>{skill}</Badge>
          ))}
        </div>
      </Window>
    </Card>

    <div class="flow flow--2" style="margin-top: 20px">
      <Window>
        <div class="pane">
          <Text><strong>Frontend</strong></Text>
          <Divider />
          <p class="prose">
            Vue · Nuxt · React · Next.js · TypeScript · Pinia · Tailwind CSS · HTML Canvas ·
            Web Workers · Astro
          </p>
        </div>
      </Window>
      <Window>
        <div class="pane">
          <Text><strong>Backend &amp; tooling</strong></Text>
          <Divider />
          <p class="prose">
            Node.js · Express · Laravel · GraphQL · OpenAPI · Sentry · JWT · Docker · Postgres ·
            PHP · DatoCMS · Jest · Cypress · Testing · NPM
          </p>
        </div>
      </Window>
    </div>
  </section>

  <!-- ============ EDUCATION ============ -->
  <section class="step" id="education">
    <div class="step__head">
      <span class="step__num">EDUCATION</span>
      <h2 class="step__title">Formal training</h2>
    </div>

    <div class="flow flow--2">
      {education.map((ed) => (
        <Card title={ed.school} mode="left">
          <Window>
            <div class="job">
              <div class="job__meta">
                <span class="job__role">{ed.qualification}</span>
                <span class="job__period">{ed.period}</span>
              </div>
              <Divider />
              <ul class="job__bullets">
                {ed.modules.map((m) => (
                  <li><span class="job__dot">◈</span>{m}</li>
                ))}
              </ul>
            </div>
          </Window>
        </Card>
      ))}
    </div>
  </section>

  <!-- ============ ABOUT ============ -->
  <section class="step" id="about">
    <div class="step__head">
      <span class="step__num">ABOUT</span>
      <h2 class="step__title">Off the clock</h2>
    </div>
    <Card title="HUMAN SIDE">
      <Window>
        <div class="pane">
          <Text>
            Developer based in Leicestershire. In my spare time I enjoy{' '}
            <strong>skateboarding</strong>, <strong>breakdancing</strong> and playing{' '}
            <strong>chess</strong>.
          </Text>
        </div>
      </Window>
    </Card>
  </section>

  <!-- ============ CONTACT ============ -->
  <section class="step" id="contact">
    <div class="step__head">
      <span class="step__num">CONTACT</span>
      <h2 class="step__title">Get in touch</h2>
    </div>
    <Window>
      <div class="pane">
        <Table>
          <TableRow>
            <TableColumn><Badge>EMAIL</Badge></TableColumn>
            <TableColumn><a class="contact-link" href="mailto:javierharford@gmail.com">javierharford@gmail.com</a></TableColumn>
          </TableRow>
          <TableRow>
            <TableColumn><Badge>GITHUB</Badge></TableColumn>
            <TableColumn><a class="contact-link" href="https://github.com/Javier-Romario" target="_blank" rel="noopener">github.com/Javier-Romario</a></TableColumn>
          </TableRow>
          <TableRow>
            <TableColumn><Badge>LINKEDIN</Badge></TableColumn>
            <TableColumn><a class="contact-link" href="https://www.linkedin.com/in/javier-romario-0a64727b" target="_blank" rel="noopener">linkedin.com/in/javier-romario-0a64727b</a></TableColumn>
          </TableRow>
        </Table>
      </div>
    </Window>
  </section>
</Layout>
